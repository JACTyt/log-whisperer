ids":["fadd7c7e33dae68a"]},{"tactic":"initial-access","technique_id":"T1190","name":"Exploit Public-Facing Application","url":"https://attack.mitre.org/techniques/T1190","step_indexes":[2,3],"detection_ids":["f6e473bceee5a230","0d2fd85479409564","19a8a8036580f5ba","9623ea8938bf703a"]},{"tactic":"persistence","technique_id":"T1098","name":"Account Manipulation","url":"https://attack.mitre.org/techniques/T1098","step_indexes":[6,8],"detection_ids":["b31d12a32c0e2bf5"]},{"tactic":"persistence","technique_id":"T1136.001","name":"Local Account","url":"https://attack.mitre.org/techniques/T1136/001","step_indexes":[6],"detection_ids":["b31d12a32c0e2bf5"]},{"tactic":"credential-access","technique_id":"T1110.001","name":"Password Guessing","url":"https://attack.mitre.org/techniques/T1110/001","step_indexes":[4],"detection_ids":["fadd7c7e33dae68a"]}],"narrative":{"incident_id":"898f3d5b85759b2e","model":"ollama:ssfdre38/gemma4-turbo:e4b","created_at":"2026-10-23T20:24:37","narrative":{"summary":{"text":"The incident began with initial access attempts via web application vulnerabilities, specifically SQL Injection and Path Traversal, originating from 203.0.113.7. Following these web exploits, the attacker engaged in brute-force attacks against SSH services (T1110.001), eventually achieving a successful root login at 14:09:12Z. The attacker then established persistence by creating a new user account ('backdoor') and subsequently escalated privileges by adding this user to the 'sudo' group. Using the compromised backdoor account, the attacker successfully accessed sensitive system files like /etc/shadow and downloaded external scripts before establishing a root shell session.","event_ids":["39556e835033ec84","e3e3474d6e1e92a9","caf827264088ccbe","26a753e1cc3507ea","d1d1dc4b2a3a19a5","a9ed87269f5927ec","211d1d0d86770786","893bf42b182fbce5","d3829d1d703a1f81","d71fe7b9593c4765","81d99b4781719d00","52fc0561f8da6949","4d0f486f262400ab","accb1038eacc1285","76835647b2351a29","6286dd3fc2b60974","311c7822d9cb3aac","be7ee3876e1dc464","39603c84dfb11785","76239dcb02685a0c","96bd98fd4ae3dd42","2bc3f8d3ebe920d8","7aaf5133378eca8a","fed06bace7471706","a2b8b5642a4b060f","b054e8a2a4ed482b","03efe3f2bd0ad8e8","63f2f12b1fcfc072","093d5e8ee88c82ad","bed45df1edb72089"]},"summary_is_template":false,"steps":[{"ts":"2026-03-14T13:55:01","text":"A cron session was opened and subsequently closed for the root user on web01. (E1, E2)","event_ids":["c56c77ead4652b21","5a7f938156164274"],"techniques":[]},{"ts":"2026-03-14T13:58:40","text":"A successful SSH authentication occurred for the user 'deploy' from 192.168.10.5 to web01. (E3)","event_ids":["dc861be5374e92ce"],"techniques":[]},{"ts":"2026-03-14T13:59:30","text":"The source IP 203.0.113.7 attempted a SQL injection attack against /products.php, first resulting in a failure (E4) and then achieving success by executing a UNION SELECT query (E5).","event_ids":["39556e835033ec84","e3e3474d6e1e92a9"],"techniques":["T1190"]},{"ts":"2026-03-14T14:00:05","text":"The source IP 203.0.113.7 attempted a path traversal attack against /download.php, requesting the contents of /etc/passwd (E6).","event_ids":["caf827264088ccbe"],"techniques":["T1190"]},{"ts":"2026-03-14T14:02:01","text":"The source IP 203.0.113.7 attempted multiple failed SSH logins against users 'root' and 'admin' (E7, E8, E9, E10, E11, E12, E13).","event_ids":["26a753e1cc3507ea","d1d1dc4b2a3a19a5","a9ed87269f5927ec","211d1d0d86770786","893bf42b182fbce5","d3829d1d703a1f81","d71fe7b9593c4765","81d99b4781719d00","52fc0561f8da6949","4d0f486f262400ab","accb1038eacc1285","76835647b2351a29","6286dd3fc2b60974","311c7822d9cb3aac"],"techniques":["T1110.001","T1078"]},{"ts":"2026-03-14T14:09:12","text":"The source IP 203.0.113.7 successfully authenticated as 'root' via SSH (E15, E16).","event_ids":["be7ee3876e1dc464","39603c84dfb11785"],"techniques":[]},{"ts":"2026-03-14T14:11:03","text":"The user 'backdoor' was created and assigned to the new group 'backdoor' on web01 (E17, E18).","event_ids":["76239dcb02685a0c","96bd98fd4ae3dd42"],"techniques":["T1136.001","T1098"]},{"ts":"2026-03-14T14:11:20","text":"The password for the user 'backdoor' was changed (E19).","event_ids":["2bc3f8d3ebe920d8"],"techniques":[]},{"ts":"2026-03-14T14:11:31","text":"The user 'backdoor' was added to the 'sudo' group (E20, E21).","event_ids":["7aaf5133378eca8a","fed06bace7471706"],"techniques":["T1098"]},{"ts":"2026-03-14T14:13:45","text":"The user 'backdoor' successfully authenticated via SSH from 203.0.113.7 (E22).","event_ids":["a2b8b5642a4b060f"],"techniques":[]},{"ts":"2026-03-14T14:14:02","text":"The user 'backdoor' successfully executed a sudo command to read /etc/shadow (E23).","event_ids":["b054e8a2a4ed482b"],"techniques":[]},{"ts":"2026-03-14T14:14:30","text":"The user 'backdoor' used sudo to download a script from 203.0.113.7 and save it as /tmp/x.sh (E24).","event_ids":["03efe3f2bd0ad8e8"],"techniques":[]},{"ts":"2026-03-14T14:15:10","text":"The user 'backdoor' opened a session as root via su (E25).","event_ids":["63f2f12b1fcfc072"],"techniques":[]},{"ts":"2026-03-14T14:20:00","text":"A failed sudo attempt was logged by the 'www' user (E26).","event_ids":["093d5e8ee88c82ad"],"techniques":[]},{"ts":"2026-03-14T14:25:01","text":"A new cron session was opened for the root user (E27).","event_ids":["bed45df1edb72089"],"techniques":[]}],"rejected":[]}}}